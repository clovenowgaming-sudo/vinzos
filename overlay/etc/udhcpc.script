#!/bin/sh
RESOLV=/etc/resolv.conf
case "$1" in
    deconfig)
        ifconfig "$interface" 0.0.0.0
        ;;
    bound|renew)
        ifconfig "$interface" "$ip" netmask "${subnet:-255.255.255.0}"
        while route del default dev "$interface" 2>/dev/null; do :; done
        if [ -n "$router" ]; then
            route add default gw "${router%% *}" dev "$interface"
        fi
        : > "$RESOLV"
        [ -n "$domain" ] && echo "search $domain" >> "$RESOLV"
        for d in $dns; do echo "nameserver $d" >> "$RESOLV"; done
        grep -q nameserver "$RESOLV" || printf 'nameserver 1.1.1.1\nnameserver 8.8.8.8\n' >> "$RESOLV"
        mkdir -p /var/run
        echo "$interface $ip" > /var/run/vnet.ip
        ;;
esac
exit 0
